{
  "name": "privacy-rendering-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Render videos with private regions and audio obscured, driven by a declarative redaction plan (Editframe)",
  "type": "module",
  "scripts": {
    "dev": "EF_NO_TELEMETRY=1 vite --port 5173 --strictPort --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "render": "bash scripts/render.sh",
    "render:talking-head": "npm run render -- talking-head",
    "render:screen-recording": "npm run render -- screen-recording",
    "verify": "python3 scripts/verify.py",
    "extract": "node scripts/extract-tracks.mjs",
    "check:plans": "node scripts/extract-tracks.mjs --check",
    "standins": "bash scripts/render-standins.sh"
  },
  "dependencies": {
    "@editframe/cli": "0.60.11",
    "@editframe/elements": "0.60.11",
    "@editframe/react": "0.60.11",
    "@editframe/vite-plugin": "0.60.11",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "playwright": "1.63.0",
    "typescript": "^5.6.0"
  }
}
